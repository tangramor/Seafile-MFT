# ================================
# 内网 Seafile 配置
# ================================
INTRANET_SEAFILE_URL=http://192.168.101.111
INTRANET_SEAFILE_TOKEN=your_intranet_api_token
INTRANET_REPO_ID=eb8d70e1-736c-4548-b1bc-01d129071a11

# ================================
# 外网 Seafile 配置
# ================================
EXTRANET_SEAFILE_URL=https://seafile.example.com
EXTRANET_SEAFILE_TOKEN=your_extranet_api_token
EXTRANET_REPO_ID=your_extranet_repo_id

# ================================
# 邮件服务配置 - 内网 SMTP
# （审核人在内网时收到的邮件，审批链接为内网地址）
# ================================
INTRANET_SMTP_HOST=smtp.example.com
INTRANET_SMTP_PORT=465
INTRANET_SMTP_USER=notify@example.com
INTRANET_SMTP_PASSWORD=your_smtp_password
INTRANET_SMTP_USE_SSL=true

# ================================
# 邮件服务配置 - 外网 SMTP
# （审核人在外网时收到的邮件，审批链接为外网地址）
# 若外网与内网共用同一 SMTP，只需填写内网配置，此处留空即可
# ================================
EXTRANET_SMTP_HOST=smtp.example.com
EXTRANET_SMTP_PORT=465
EXTRANET_SMTP_USER=notify@example.com
EXTRANET_SMTP_PASSWORD=your_smtp_password
EXTRANET_SMTP_USE_SSL=true

# 审批人邮箱（多个用逗号分隔；内网和外网邮件都发给这些人）
REVIEWER_EMAILS=reviewer1@example.com,reviewer2@example.com

# ================================
# 应用配置
# ================================
# 内网访问地址（内网邮件的审批链接）
INTRANET_APP_URL=http://192.168.101.111:8081
# 外网访问地址（外网邮件的审批链接）
EXTRANET_APP_URL=http://pan.longtubas.com:8081
# 旧版兼容字段（若未设置 INTRANET_APP_URL 则回退到此）
APP_BASE_URL=http://192.168.101.111:8081
SECRET_KEY=change-me-to-a-random-secret-key-32chars
DATABASE_URL=sqlite:///./seafile_mft.db

# Token 有效期（小时）
REVIEW_TOKEN_EXPIRE_HOURS=72

# ================================
# 认证方式配置
# ================================
# 认证方式：local（仅本地账密）/ ldap（admin 用本地，其他用 LDAP）/ seafile（admin 用本地，其他用 Seafile API）
AUTH_METHOD=seafile

# 当 AUTH_METHOD=seafile 时，指定使用哪个 Seafile 验证：intranet / extranet
AUTH_SEAFILE=intranet

# ================================
# LDAP 认证配置
# ================================
# LDAP 服务器地址（留空则禁用 LDAP，仅允许本地账号登录）
LDAP_HOST=192.168.101.10
LDAP_PORT=389
LDAP_USE_SSL=false
# LDAP 搜索基础 DN
LDAP_BASE_DN=dc=longtubas,dc=com
# 用户 DN 模板（{username} 会被替换为实际用户名）
# 格式1 (OpenLDAP): uid={username},ou=users,dc=longtubas,dc=com
# 格式2 (AD):       {username}@longtubas.com
LDAP_USER_DN_TEMPLATE=uid={username},ou=users,dc=longtubas,dc=com
# 对应审核者的 LDAP 用户组名
LDAP_REVIEWER_GROUP=mft-reviewers
# 对应管理员的 LDAP 用户组名
LDAP_ADMIN_GROUP=mft-admins

# ================================
# 本地默认管理员（首次部署初始化）
# ================================
# 留空则不自动创建本地 admin 账号
DEFAULT_ADMIN_PASSWORD=admin123

# ================================
# 轮询配置（适配 Seafile 6.x，替代 Webhook）
# ================================
# 轮询间隔（秒）：建议内网 30~60 秒，对延迟不敏感可设 300 秒
POLL_INTERVAL_SECONDS=60

# 启动时立即执行一次轮询（true/false）
POLL_ON_STARTUP=true

# ================================
# 出口 DLP 扫描（集成 scan-worker 微服务）
# 默认关闭；设为 true 后，文件审批通过、传出外网前会先送 scan-worker 扫描
# 命中（达到 DLP_ALERT_SEVERITIES）则挂起等审核者确认，干净则自动放行
# 注意：需在同一 Docker 网络部署 scan-worker 栈（见 scan-worker/docker-compose.yml 或 test/docker-compose.yml）
# ================================
# 是否开启 DLP 出口扫描（true/false）
DLP_ENABLED=false
# scan-worker 网关地址（MFT 把待扫描文件提交到此网关）
DLP_GATEWAY_URL=http://scan-gateway:8080
# 接收扫描结果的 Webhook；留空则自动取 {APP_BASE_URL}/internal/dlp-webhook
# 容器间通信请用 MFT 容器内地址（如 http://seafile-mft:8080/internal/dlp-webhook），不要用 localhost
DLP_CALLBACK_URL=
# 达到这些严重度（逗号分隔）才挂起等待审核者确认
DLP_ALERT_SEVERITIES=critical,high
# 超过此大小（字节）跳过扫描直接放行（默认 100MB = 104857600）
DLP_MAX_FILE_SIZE=104857600
# 提交网关的超时时间（秒）
DLP_SUBMIT_TIMEOUT=30
# true=扫描提交失败则拦截不放行；false=放行（默认，避免 DLP 故障阻断业务）
DLP_FAIL_CLOSED=false
